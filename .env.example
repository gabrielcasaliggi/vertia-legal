NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-api-key

# Texto nativo (PDF digital). Free tier: ~100k TPD por modelo.
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback si agotás cuota del 70B (cuota separada, más rápido):
# GROQ_MODEL=llama-3.1-8b-instant

# PDFs escaneados (Vision OCR + auditoría)
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
# Mayor precisión OCR (consume más cuota):
# GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# Notificaciones por email (SMTP libre / propio)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=vertia@estudio.com
# NOTIFICATION_DIGEST_TO=socio@estudio.com
# NOTIFICATION_CRON_SECRET=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Producción Vercel: PDF escaneado requiere OCR pesado (puede fallar en Hobby).
# ALLOW_SERVER_OCR=true
